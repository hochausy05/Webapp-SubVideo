# Backend configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WORKER_QUEUE_WARN_SECONDS=60

# Supabase project configuration (backend only; never use in VITE_ variables)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
MEDIA_BUCKET=autodub-private-media

# Proposed configurable source-video defaults (D03 remains open)
MAX_VIDEO_UPLOAD_BYTES=536870912
MAX_VIDEO_DURATION_SECONDS=7200
FFPROBE_PATH=ffprobe

# Gemini translation provider
GEMINI_API_KEY=

# Optional Supertonic 3 model cache (backend only)
TTS_MODEL_DIR=.cache/tts/models
